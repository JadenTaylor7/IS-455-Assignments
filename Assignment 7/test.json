                    "UserArea": {
                        "Details": {
                            "JobSummary": "This position is located in the Department of Technology Services (DTS), Systems Development and Support Office (SDSO), Software Infrastructure Division (SID). The SID Chief will be instrumental in evolving the division into a Platform Engineering Division supporting on-prem and cloud-based Identity, Credential and Access Management (ICAM) platforms, DevSecOps platforms, and ITSM platforms for the Federal Judiciary.",
                            "WhoMayApply": {
                                "Name": "",
