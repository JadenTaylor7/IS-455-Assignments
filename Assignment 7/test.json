                    "UserArea": {
                        "Details": {
                            "JobSummary": "The Department of Homeland Security (DHS) is recruiting professionals to support a range of leadership roles in Cybersecurity Defensive Operations - Intelligence Collection & Analysis as well as Planning, Execution & Analysis, including Cyber Operations Lead, All Source-Collection Manager, All Source-Collection Requirements Manager and Network Operations Security Center Lead. All positions are in the DHS Cybersecurity Service.",
                            "WhoMayApply": {
                                "Name": "",
