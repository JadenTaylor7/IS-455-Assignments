                    "UserArea": {
                        "Details": {
                            "JobSummary": "The Department of Homeland Security (DHS) is recruiting professionals to support a range of leadership roles in Cybersecurity Architecture, including Enterprise Engineering Architect, Enterprise Architecture Branch Chief, Deputy Section Chief, Shift Management Lead and Technology Strategy Branch Chief. All positions are in the DHS Cybersecurity Service.",
                            "WhoMayApply": {
