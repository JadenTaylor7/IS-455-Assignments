                    "UserArea": {
                        "Details": {
                            "JobSummary": "The Department of Homeland Security (DHS) is recruiting professionals to support a range of technical roles in Cybersecurity Engineering, including. Cybersecurity Engineer, Information Security Analyst, Network Engineer, and Lead Software Developer. All positions are in the DHS Cybersecurity Service.",
                            "WhoMayApply": {
                                "Name": "",
