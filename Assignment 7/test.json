                    ],
                    "PositionStartDate": "2025-01-21T09:23:05.9030",
                    "PositionEndDate": "2025-02-06T23:59:59.9970",
                    "PublicationStartDate": "2025-01-21T09:23:05.9030",
                    "ApplicationCloseDate": "2025-02-06T23:59:59.9970",
                    "PositionFormattedDescription": [
                        {
                            "Label": "Dynamic Teaser",
