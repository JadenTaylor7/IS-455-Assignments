                    "UserArea": {
                        "Details": {
                            "JobSummary": "Please limit your resume to 5 pages. If more than 5 pages are submitted, only the first 5 pages will be reviewed to determine your eligibility/qualifications. About the Position: Provide expert advice to resolve complex problems associated with development, design, standardization, and integration of current next generation software/systems to support the Army's information needs.",
                            "WhoMayApply": {
