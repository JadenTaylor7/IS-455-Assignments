                    "UserArea": {
                        "Details": {
                            "JobSummary": "This is a public notice flyer to notify interested applicants of anticipated vacancies through STRL Mission Support Direct Hire Authority. Applications will not be accepted through this flyer. Interested applicants must follow the directions in the \"How to Apply\" section of this flyer to be considered. There may or may not be actual vacancies filled from this flyer. Notice of Result letters will not be sent to applicants who respond to this flyer.",
                            "WhoMayApply": {
                                "Name": "",
                                "Code": ""
                            },
                            "LowGrade": "4",
                            "HighGrade": "4",
                            "PromotionPotential": "None",
