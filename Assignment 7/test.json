                    "UserArea": {
                        "Details": {
                            "JobSummary": "Please limit your resume to 5 pages. If more than 5 pages are submitted, only the first 5 pages will be reviewed to determine your eligibility/qualifications. About the Position: As a Data Scientist within CECOM G8's Command Financial Analysis Office (CFAO), responsible for performing financial analysis functions spanning the PPBE process to promote financial operations visibility and improve resource management performance.",
                            "WhoMayApply": {
                                "Name": "",
