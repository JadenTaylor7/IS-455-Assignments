                    "UserArea": {
                        "Details": {
                            "JobSummary": "This vacancy is for a GS-2210-12/13, IT Cybersecurity Specialist located in the Department of Homeland Security, U.S. Coast Guard, SFLC BOD INFORMATION SERVICES BR.",
                            "WhoMayApply": {
                                "Name": "",
                                "Code": ""
                            },
                            "LowGrade": "12",
                            "HighGrade": "13",
                            "PromotionPotential": "13",
                            "SubAgencyName": "Business Operations Div",
                            "OrganizationCodes": "HS/HSAC",
