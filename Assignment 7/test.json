                    "UserArea": {
                        "Details": {
                            "JobSummary": "The Department of Homeland Security (DHS) is recruiting professionals to support a range of technical roles in Mitigation and Response, including Cyber Defense Incident Responder, Cyber Incident Response Analyst, and Cyber Intrusion Detection Specialist. All positions are in the DHS Cybersecurity Service.",
                            "WhoMayApply": {
