                    "UserArea": {
                        "Details": {
                            "JobSummary": "Please limit your resume to 5 pages. If more than 5 pages are submitted, only the first 5 pages will be reviewed to determine your eligibility/qualifications. About the Position: Serves as a principal advisor and assistant to the Chief of Financial Operations, in the G8 RM Directorate Financial Operations Division, Installation Management Command (HQ IMCOM), located at Fort Sam Houston, TX.",
                            "WhoMayApply": {
                                "Name": "",
